<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Levi Timothy | Entrepreneur • Trader • Builder</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Inter:wght@300;400;600&family=Playfair+Display:ital@1&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0B0B0F',
                        softGrey: '#12121A',
                        gold: '#D4AF37',
                        softWhite: '#EAEAEA',
                    },
                    fontFamily: {
                        signature: ['Great Vibes', 'cursive'],
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #0B0B0F; color: #EAEAEA; scroll-behavior: smooth; }
        .fade-in { opacity: 0; transform: translateY(20px); transition: all 0.8s ease-out; }
        .fade-in.visible { opacity: 1; transform: translateY(0); }
        .gold-border-focus:focus { border-color: #D4AF37; outline: none; box-shadow: 0 0 5px #D4AF37; }
        .btn-hover:hover { box-shadow: 0 0 15px rgba(212, 175, 55, 0.4); }
    </style>
</head>
<body class="font-sans">

    <!-- Navigation -->
    <nav class="p-6 flex justify-between items-center max-w-7xl mx-auto">
        <div class="text-2xl font-signature text-gold">Levi Timothy</div>
        <div class="hidden md:flex space-x-8 text-sm uppercase tracking-widest">
            <a href="#about" class="hover:text-gold transition">About</a>
            <a href="#skills" class="hover:text-gold transition">Skills</a>
            <a href="#projects" class="hover:text-gold transition">Projects</a>
            <a href="#contact" class="hover:text-gold transition">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="h-screen flex flex-col justify-center items-center text-center px-4 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-[#1a1a24] via-darkBg to-darkBg">
        <h1 class="text-6xl md:text-8xl font-signature text-gold mb-2">Levi Timothy</h1>
        <p class="text-sm uppercase tracking-[0.3em] mb-8 text-gray-400">Entrepreneur • Trader • Builder</p>
        <h2 class="text-2xl md:text-3xl font-light mb-10 max-w-2xl">Building discipline, skill, and financial independence.</h2>
        <div class="flex flex-col md:flex-row gap-4">
            <a href="#projects" class="px-8 py-3 border border-gold text-gold btn-hover transition uppercase tracking-widest text-xs">Explore My Work</a>
            <a href="#contact" class="px-8 py-3 bg-gold text-darkBg font-bold btn-hover transition uppercase tracking-widest text-xs">Contact Me</a>
        </div>
    </section>

    <!-- Identity Statement -->
    <section class="py-24 px-6 text-center bg-softGrey">
        <div class="max-w-3xl mx-auto fade-section">
            <p class="text-xl md:text-2xl font-serif italic text-gray-300 leading-relaxed">
                "I am focused on growth, consistency, and building a life of independence through skill, strategy, and discipline."
            </p>
            <div class="w-12 h-[1px] bg-gold mx-auto mt-8"></div>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="py-24 px-6 max-w-7xl mx-auto">
        <h3 class="text-center text-gold uppercase tracking-[.5em] mb-16">Expertise</h3>
        <div class="grid md:grid-cols-3 gap-12">
            <!-- Trading -->
            <div class="space-y-4 border-l border-gray-800 pl-6">
                <h4 class="text-xl font-bold text-gold uppercase">Trading</h4>
                <ul class="text-gray-400 space-y-2 text-sm">
                    <li>Market Structure Analysis</li>
                    <li>Risk Management Principles</li>
                    <li>Developing Consistency</li>
                </ul>
            </div>
            <!-- Business -->
            <div class="space-y-4 border-l border-gray-800 pl-6">
                <h4 class="text-xl font-bold text-gold uppercase">Business</h4>
                <ul class="text-gray-400 space-y-2 text-sm">
                    <li>Side Hustle Development</li>
                    <li>Digital Opportunities</li>
                    <li>Entrepreneurial Thinking</li>
                </ul>
            </div>
            <!-- Personal -->
            <div class="space-y-4 border-l border-gray-800 pl-6">
                <h4 class="text-xl font-bold text-gold uppercase">Personal</h4>
                <ul class="text-gray-400 space-y-2 text-sm">
                    <li>Discipline & Focus</li>
                    <li>Continuous Learning</li>
                    <li>Strategic Execution</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-24 px-6 bg-softGrey">
        <div class="max-w-xl mx-auto text-center">
            <h2 class="text-4xl font-serif mb-12">Let’s connect.</h2>
            <form class="space-y-6 text-left">
                <input type="text" placeholder="Name" class="w-full bg-darkBg border border-gray-800 p-4 gold-border-focus text-softWhite">
                <input type="email" placeholder="Email" class="w-full bg-darkBg border border-gray-800 p-4 gold-border-focus text-softWhite">
                <textarea placeholder="Message" rows="4" class="w-full bg-darkBg border border-gray-800 p-4 gold-border-focus text-softWhite"></textarea>
                <button class="w-full py-4 bg-gold text-darkBg font-bold uppercase tracking-widest btn-hover transition">Send Message</button>
            </form>
            <div class="mt-12 flex justify-center space-x-6 text-gray-400">
                <a href="mailto:leevchord247@gmail.com" class="hover:text-gold">Email</a>
                <a href="https://instagram.com/diceo_fficial" class="hover:text-gold">Instagram</a>
                <a href="tel:08062061769" class="hover:text-gold">WhatsApp</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-10 text-center text-xs text-gray-600 uppercase tracking-widest">
        &copy; 2024 Levi Timothy. All Rights Reserved.
    </footer>

    <script>
        // Simple Scroll Animation
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('section, .fade-section').forEach(section => {
            section.classList.add('fade-in');
            observer.observe(section);
        });
    </script>
</body>
</html>
